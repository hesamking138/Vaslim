<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vaslim.NotSidebar"
             Title="Live Monitor"
             FlowDirection="LeftToRight"
             BackgroundColor="#0A0A0C">
    <VerticalStackLayout Padding="20">
        <Label Text="// LIVE_MONITOR" FontSize="18" TextColor="#565F89" FontAttributes="Bold" Margin="0,0,0,20"/>
        <CollectionView x:Name="SiteMonitorList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="30, *" Padding="10">
                        <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" Fill="{Binding StatusColor}" />
                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" TextColor="#C0CAF5" VerticalOptions="Center" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
