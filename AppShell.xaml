<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Vaslim.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Vaslim"
    Shell.NavBarIsVisible="False"
    Title="Vaslim?">

    <ShellContent
        Title="Connectivity"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Gaming"
        ContentTemplate="{DataTemplate local:GamePing}"
        Route="GamePing" />

</Shell>
